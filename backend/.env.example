# Local content workspace. If you do not have a separate gzhpublisher repo,
# point these directories at any local folder you want to use for generated articles.
GZHPUBLISHER_ROOT=C:/path/to/gzhpublisher
ARTICLES_DIR=C:/path/to/gzhpublisher/articles/published
BENCHMARKS_DIR=C:/path/to/gzhpublisher/skills/fuwei-geo/references/benchmark-articles
ASSETS_DIR=C:/path/to/gzhpublisher/assets

# Required for Analytics > Update Data.
# Create these in the WeChat Official Account platform and whitelist this machine's public IP.
# If WeChat returns credential/IP errors, open Settings > Test WeChat Connection.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_STATS_DAYS_BACK=365
WECHAT_STATS_MAX_WORKERS=1

# AI writer. claude_cli keeps current behavior; openai_compatible is for API-key based providers.
# claude_cli:
#   AI_PROVIDER=claude_cli
#   CLAUDE_BIN=C:/Users/me/AppData/Roaming/npm/claude.cmd
# openai_compatible:
#   AI_PROVIDER=openai_compatible
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=deepseek-chat
AI_PROVIDER=claude_cli
CLAUDE_BIN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PRESET_PROVIDER=
AI_EXTRA_BODY_JSON=

# Optional external search and hot-source presets. Search results should include
# a source URL before they are approved into the formal material library.
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
HOT_SOURCE_PRESETS_JSON=

# Optional proxy for WeChat/API calls.
HTTPS_PROXY=

FLASK_PORT=5001
FLASK_DEBUG=false
